# u2-cht 打包環境:Ubuntu 22.04 + SDL2 + AppImage 工具 + mingw(Windows cross)
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config file wget ca-certificates zip \
    libsdl2-dev libsdl2-ttf-dev libsdl2-image-dev \
    fonts-wqy-zenhei python3 python3-pil \
    mingw-w64 \
    && rm -rf /var/lib/apt/lists/*
# AppImage 工具(--appimage-extract-and-run 免 FUSE)
RUN wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
      -O /opt/linuxdeploy && chmod +x /opt/linuxdeploy && \
    wget -q https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage \
      -O /opt/appimagetool && chmod +x /opt/appimagetool
ENV APPIMAGETOOL=/opt/appimagetool LINUXDEPLOY=/opt/linuxdeploy
